# ─── Supabase ───────────────────────────────────────
# Create a project at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ─────────────────────────────────────────
# Create an account at: https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# ─── OpenRouter (required for chat) ────────────────
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Dev Auth Bypass (local only) ───────────────────
# Skip Supabase auth in development. Only works when NODE_ENV=development.
# DEV_BYPASS_AUTH=true

# ─── GitHub (optional fallback) ─────────────────────
# Users authenticate with GitHub OAuth (handled by Supabase Auth).
# This token is only needed as a server-side fallback for unauthenticated
# API calls during development.
# GITHUB_TOKEN=

# ─── Agent Analysis (optional overrides) ────────────
# Models used for the agentic codebase exploration pipeline.
# Defaults shown below — override to use different models via OpenRouter.
# AGENT_EXPLORATION_MODEL=anthropic/claude-haiku-3.5-20241022
# AGENT_SYNTHESIS_MODEL=anthropic/claude-sonnet-4
