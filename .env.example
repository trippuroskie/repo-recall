# ─── Supabase ───────────────────────────────────────
# Create a project at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ─────────────────────────────────────────
# Create an account at: https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# ─── OpenRouter (required for chat) ────────────────
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Dev Auth Bypass (local only) ───────────────────
# Skip Supabase auth in development. Only works when NODE_ENV=development.
# DEV_BYPASS_AUTH=true

# ─── GitHub (optional fallback) ─────────────────────
# Users authenticate with GitHub OAuth (handled by Supabase Auth).
# This token is only needed as a server-side fallback for unauthenticated
# API calls during development.
# GITHUB_TOKEN=

# ─── Admin ──────────────────────────────────────────
# Secret key for admin endpoints (indexing, refresh).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# ─── Agent Analysis (optional overrides) ────────────
# Models used for the agentic codebase exploration pipeline, resolved in
# src/lib/agent/orchestrator.ts. The values below are the current defaults —
# override with any OpenRouter model ID. Exploration runs many tool-calling
# turns, so it wants a fast, cheap model; synthesis runs once and wants a
# stronger one.
# AGENT_EXPLORATION_MODEL=google/gemini-3-flash-preview
# AGENT_SYNTHESIS_MODEL=google/gemini-3.1-pro-preview

# ─── Umami Analytics (optional, off by default) ─────
# Point these at YOUR OWN Umami instance. Both must be set, and the build must
# be a production build, before any analytics script is loaded. Leave unset
# (the default) and the app ships with no tracking whatsoever.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.example.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
